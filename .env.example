# Copy to .env for local dev (never commit real values)
SUPABASE_URL=https://wwdwbnhswynjcxeerdgz.supabase.co
SUPABASE_ANON_KEY=
# Optional. If unset, privileged DB calls use API_SERVER_SECRET instead.
SUPABASE_SERVICE_ROLE_KEY=
# Random 64-hex string; its sha256 lives in private.app_config (key server_secret_sha256)
API_SERVER_SECRET=
FAL_KEY=
# Optional overrides
DAILY_GENERATION_LIMIT=10
PUBLIC_BASE_URL=
MODERATION_WEBHOOK_URL=

# Everyone gets demo clips. Real fal clips only for owners when REAL_FOR_OWNERS=true.
GENERATION_MODE=demo
REAL_FOR_OWNERS=false
# Comma-separated Supabase user ids and/or confirmed emails
OWNER_USER_IDS=
OWNER_EMAILS=
OWNER_DAILY_REAL_CAP=5
# First entry is the default real model
OWNER_REAL_MODELS=fast,seedance,kling
